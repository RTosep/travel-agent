# ===== 方案 A：DeepSeek（推荐）=====
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：默认就是 https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：默认 deepseek-flash；更强模型可用 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-flash

# ===== 方案 B：OpenAI / 其他兼容网关 =====
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# 可选：显式选择 provider，不填则按 Key 自动判断
# LLM_PROVIDER=deepseek

# 高德地图 Web服务 Key（天气定位、POI 搜索、路径规划都需要）
AMAP_API_KEY=你的高德Web服务Key

# 可选：Agent 最多循环多少轮，默认 8
# AGENT_MAX_TURNS=8
